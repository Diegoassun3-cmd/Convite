# Copie este arquivo para ".env" e ajuste os valores antes de colocar em produção.

# Porta em que o servidor vai rodar.
PORT=3000

# Chave usada para assinar o cookie de sessão do painel administrativo.
# OBRIGATÓRIO em produção — gere uma string aleatória longa, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-uma-string-aleatoria-longa

NODE_ENV=production
